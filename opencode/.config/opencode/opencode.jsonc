{
  // Theme and keybinds live in cli.json, the terminal client config.
  "$schema": "https://opencode.ai/config.json",

  "model": "openrouter/moonshotai/kimi-k3",

  // Used by opencode's built-in title and summary agents, which name sessions
  // and write compaction summaries. Without it they fall back to the model
  // above.
  "small_model": "openrouter/google/gemini-2.5-flash-lite",

  "default_agent": "plan",

  // Vendored caveman ruleset (see vendor.yaml), kept out of AGENTS.md so that
  // file stays hand-written. The path has to start with ~/ or be absolute - a
  // relative one resolves against the project directory.
  "instructions": ["~/.config/opencode/rules/caveman.md"],

  "agents": {
    // Fast and cheap for edits.
    "build": {
      "model": "openrouter/deepseek/deepseek-v4.1-flash",
    },

    // Read-only agents, so a cheap model is fine - but not the cheapest, since
    // they run many tool calls and a bad one costs more turns than it saves.
    //
    // Set here rather than in the agent files because frontmatter wins over
    // this file, and the vendoring step strips the model key upstream ships.
    "cavecrew-investigator": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4.1-flash",
    },
    "cavecrew-reviewer": {
      "mode": "subagent",
      "model": "openrouter/deepseek/deepseek-v4.1-flash",
    },

    // Writes files, so it keeps the default model.
    "cavecrew-builder": {
      "mode": "subagent",
    },
  },

  "plugins": ["@dietrichgebert/ponytail"],

  "mcp": {
    "servers": {
      // Installed with Homebrew, see Brewfile.
      "terraform": {
        "type": "local",
        "command": [
          "/opt/homebrew/bin/terraform-mcp-server",
          "stdio",
          "--toolsets=registry",
        ],
      },
    },
  },

  "permissions": [
    // Denied on purpose - the bx skill replaces it, see AGENTS.md.
    { "action": "websearch", "resource": "*", "effect": "deny" },

    // Scratch space. Rules match canonical paths and /tmp is a symlink to
    // /private/tmp on macOS, so both are listed.
    { "action": "external_directory", "resource": "/tmp/*", "effect": "allow" },
    { "action": "external_directory", "resource": "/private/tmp/*", "effect": "allow" },

    // gh asks, except read-only subcommands. Last match wins.
    { "action": "bash", "resource": "gh *", "effect": "ask" },
    { "action": "bash", "resource": "gh auth status*", "effect": "allow" },
    { "action": "bash", "resource": "gh pr view*", "effect": "allow" },
    { "action": "bash", "resource": "gh pr diff*", "effect": "allow" },
    { "action": "bash", "resource": "gh pr list*", "effect": "allow" },
    { "action": "bash", "resource": "gh pr checks*", "effect": "allow" },
    { "action": "bash", "resource": "gh pr status*", "effect": "allow" },
    { "action": "bash", "resource": "gh issue view*", "effect": "allow" },
    { "action": "bash", "resource": "gh issue list*", "effect": "allow" },
    { "action": "bash", "resource": "gh run view*", "effect": "allow" },
    { "action": "bash", "resource": "gh run list*", "effect": "allow" },
    { "action": "bash", "resource": "gh repo view*", "effect": "allow" },
    { "action": "bash", "resource": "gh repo read-file*", "effect": "allow" },
    { "action": "bash", "resource": "gh repo read-dir*", "effect": "allow" },
    { "action": "bash", "resource": "gh release view*", "effect": "allow" },
    { "action": "bash", "resource": "gh release list*", "effect": "allow" },
    { "action": "bash", "resource": "gh search *", "effect": "allow" },

    // Pushing asks. Second rule catches git -C <dir> push.
    { "action": "bash", "resource": "git push*", "effect": "ask" },
    { "action": "bash", "resource": "git * push*", "effect": "ask" },
  ],

  "references": {
    "devops": {
      "path": "~/projects/github/brave/devops",
      "description": "brave/devops",
    },
    "brave-core": {
      "path": "~/projects/github/brave/brave-browser/src/brave",
      "description": "brave/brave-core",
    },
  },

  "share": "disabled",
}
